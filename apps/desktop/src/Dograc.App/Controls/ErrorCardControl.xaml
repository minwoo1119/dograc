<UserControl x:Class="Dograc.App.Controls.ErrorCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:err="clr-namespace:Dograc.Core.Errors;assembly=Dograc.Core"
             x:Name="Root">
    <Border CornerRadius="8" BorderThickness="1" Padding="16,14">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Error.Severity, ElementName=Root}" Value="{x:Static err:ErrorSeverity.Warning}">
                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Error.Severity, ElementName=Root}" Value="{x:Static err:ErrorSeverity.Information}">
                        <Setter Property="Background" Value="{DynamicResource Brush.Side}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <!-- Top Row: Icon + Title + Error Code Badge + Dismiss -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Severity Glyph (never color-only!) -->
                <Border Grid.Column="0"
                        Width="20" Height="20"
                        CornerRadius="10"
                        Margin="0,1,10,0"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error.Severity, ElementName=Root}" Value="{x:Static err:ErrorSeverity.Warning}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Error.Severity, ElementName=Root}" Value="{x:Static err:ErrorSeverity.Information}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource Brush.TextOnPrimary}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="!" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Error.Severity, ElementName=Root}" Value="{x:Static err:ErrorSeverity.Warning}">
                                        <Setter Property="Text" Value="△" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Error.Severity, ElementName=Root}" Value="{x:Static err:ErrorSeverity.Information}">
                                        <Setter Property="Text" Value="i" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <StackPanel Grid.Column="1">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Error.Title, ElementName=Root}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap" />
                        <Border Background="{DynamicResource Brush.Canvas}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Error.ErrorCode, ElementName=Root}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </Border>
                        <Border Visibility="{Binding Error.PipelineStage, ElementName=Root, Converter={StaticResource StringNotEmptyToVisibility}}"
                                Background="{DynamicResource Brush.Selected}"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Error.PipelineStage, ElementName=Root, StringFormat=단계: {0}}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding Error.Description, ElementName=Root}"
                               FontSize="12.5"
                               LineHeight="19"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>

                <Button Grid.Column="3"
                        Style="{StaticResource Button.IconGhost}"
                        Width="24" Height="24"
                        VerticalAlignment="Top"
                        Margin="8,0,0,0"
                        ToolTip="닫기"
                        Visibility="{Binding ShowDismiss, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding DismissCommand, ElementName=Root}">
                    <Viewbox Width="10" Height="10">
                        <Path Data="{StaticResource Icon.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="24" Height="24" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Structured Cause / Impact / Resolution -->
            <StackPanel Margin="30,10,0,0">
                <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}">
                    <Run Text="{Binding Error.CausePrefixLabel, ElementName=Root, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=": " />
                    <Run Text="{Binding Error.Cause, ElementName=Root, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0">
                    <Run Text="영향: " FontWeight="SemiBold" />
                    <Run Text="{Binding Error.Impact, ElementName=Root, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,3,0,0">
                    <Run Text="해결 방법: " FontWeight="SemiBold" />
                    <Run Text="{Binding Error.Resolution, ElementName=Root, Mode=OneWay}" />
                </TextBlock>

                <!-- Recovery Actions + Technical Details Toggle -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Error.RecoveryActions, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        ToolTip="{Binding Tooltip}"
                                        Height="30"
                                        Padding="11,0"
                                        FontSize="12"
                                        Margin="0,0,6,4"
                                        Command="{Binding ActionCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnPrimary}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleButton x:Name="DetailsToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource Brush.TextMuted}"
                                  FontSize="11.5"
                                  Content="진단 상세 ▾" />
                </Grid>

                <!-- Collapsible Diagnostic Details -->
                <Border Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource Brush.Canvas}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{Binding Error.FormattedTimestamp, ElementName=Root, StringFormat=발생 시각: {0}}" />
                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{Binding Error.TechnicalDetails, ElementName=Root}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        dograc Desktop Localization Resource Dictionary (ko-KR default).
        Future locales (e.g. Strings.en-US.xaml) can swap this merged dictionary at runtime
        without modifying view layouts or design tokens.
    -->
    <sys:String x:Key="Str.App.Title">dograc</sys:String>
    <sys:String x:Key="Str.Nav.Chat">Chat</sys:String>
    <sys:String x:Key="Str.Nav.Documents">Documents</sys:String>
    <sys:String x:Key="Str.Nav.Workspaces">Workspaces</sys:String>
    <sys:String x:Key="Str.Nav.Models">Models</sys:String>
    <sys:String x:Key="Str.Nav.System">System</sys:String>
    <sys:String x:Key="Str.Nav.Settings">Settings</sys:String>

    <sys:String x:Key="Str.Documents.Header">Documents</sys:String>
    <sys:String x:Key="Str.Documents.Subtitle">워크스페이스 문서와 색인 상태를 관리합니다. PDF 또는 TXT 파일을 끌어다 놓아 업로드할 수 있습니다.</sys:String>
    <sys:String x:Key="Str.Documents.ActiveWorkspacePrefix">현재 워크스페이스:</sys:String>

    <sys:String x:Key="Str.Models.Header">Models</sys:String>
    <sys:String x:Key="Str.Models.Subtitle">로컬 Ollama 서버 연결 상태와 실행 가능한 LLM 모델을 관리합니다.</sys:String>

    <sys:String x:Key="Str.Error.DetailsExpand">진단 상세 ▾</sys:String>
    <sys:String x:Key="Str.Error.DetailsCollapse">진단 상세 접기 ▴</sys:String>
</ResourceDictionary>

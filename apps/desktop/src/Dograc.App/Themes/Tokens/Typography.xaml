<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography Tokens (from design/design-tokens.json & reference.html) -->
    <FontFamily x:Key="Font.Primary">Segoe UI, Malgun Gothic, Noto Sans KR, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono, Courier New</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.PageTitle">24</sys:Double>
    <sys:Double x:Key="FontSize.ChatHeading2">20</sys:Double>
    <sys:Double x:Key="FontSize.SectionTitle">18</sys:Double>
    <sys:Double x:Key="FontSize.TitleL">24</sys:Double>
    <sys:Double x:Key="FontSize.TitleM">18</sys:Double>
    <sys:Double x:Key="FontSize.ChatHeading3">16</sys:Double>
    <sys:Double x:Key="FontSize.ChatBody">15</sys:Double>
    <sys:Double x:Key="FontSize.ChatLineHeight">25</sys:Double>
    <sys:Double x:Key="FontSize.TitleS">14</sys:Double>
    <sys:Double x:Key="FontSize.BodyL">14</sys:Double>
    <sys:Double x:Key="FontSize.BodyM">13</sys:Double>
    <sys:Double x:Key="FontSize.EvidenceBody">13</sys:Double>
    <sys:Double x:Key="FontSize.EvidenceLineHeight">21</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Metadata">11</sys:Double>
    <sys:Double x:Key="FontSize.Micro">11</sys:Double>
</ResourceDictionary>

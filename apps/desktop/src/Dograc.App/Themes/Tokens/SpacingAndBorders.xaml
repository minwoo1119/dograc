<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Borders & Radii (from design/design-tokens.json & COMPONENTS.md) -->
    <Thickness x:Key="Border.Hairline">1</Thickness>
    <Thickness x:Key="Border.None">0</Thickness>

    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.NavItem">6</CornerRadius>
    <CornerRadius x:Key="Radius.Control">7</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">7</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">8</CornerRadius>
    <CornerRadius x:Key="Radius.Composer">12</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">12</CornerRadius>

    <!-- Spacing Scale -->
    <Thickness x:Key="Padding.Page">32</Thickness>
    <Thickness x:Key="Padding.Sidebar">16,20</Thickness>
    <Thickness x:Key="Padding.Panel">16</Thickness>
    <Thickness x:Key="Padding.Compact">8</Thickness>
    <Thickness x:Key="Padding.Button">14,0</Thickness>
    <Thickness x:Key="Padding.Input">12,0</Thickness>

    <!-- Reference Layout Geometry (1440 x 900 DIP) -->
    <sys:Double x:Key="Shell.ReferenceWidth">1440</sys:Double>
    <sys:Double x:Key="Shell.ReferenceHeight">900</sys:Double>
    <sys:Double x:Key="Shell.TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="Shell.ActivityBarWidth">52</sys:Double>
    <sys:Double x:Key="Shell.NavRailWidth">52</sys:Double>
    <sys:Double x:Key="Shell.SidebarWidth">260</sys:Double>
    <sys:Double x:Key="Shell.ContextPanelWidth">344</sys:Double>
    <sys:Double x:Key="Shell.StatusBarHeight">24</sys:Double>
    <sys:Double x:Key="Shell.ChatHeaderHeight">60</sys:Double>
    <sys:Double x:Key="Shell.ChatMaxWidth">720</sys:Double>
    <sys:Double x:Key="Shell.ComposerMinHeight">96</sys:Double>
    <sys:Double x:Key="Shell.ContextTabsHeight">44</sys:Double>
    <sys:Double x:Key="Control.ButtonHeight">36</sys:Double>
    <sys:Double x:Key="Control.IconButtonSize">32</sys:Double>
</ResourceDictionary>

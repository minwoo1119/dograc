<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- dograc Design System — Dark Theme Tokens (from design/tokens.css & design-tokens.json) -->
    <Color x:Key="Color.Canvas">#181A1F</Color>
    <Color x:Key="Color.Side">#202228</Color>
    <Color x:Key="Color.Rail">#1D1F25</Color>
    <Color x:Key="Color.SurfaceTone">#262930</Color>
    <Color x:Key="Color.Hover">#2D3039</Color>
    <Color x:Key="Color.Pressed">#353945</Color>
    <Color x:Key="Color.Selected">#30334E</Color>
    <Color x:Key="Color.Border">#343740</Color>
    <Color x:Key="Color.BorderSubtle">#343740</Color>
    <Color x:Key="Color.BorderStrong">#484C58</Color>

    <Color x:Key="Color.Accent">#9296EA</Color>
    <Color x:Key="Color.Primary">#5055B1</Color>
    <Color x:Key="Color.PrimaryHover">#454AA3</Color>
    <Color x:Key="Color.PrimaryPressed">#393E90</Color>
    <Color x:Key="Color.PrimarySubtle">#30334E</Color>
    <Color x:Key="Color.PrimaryBorder">#484C58</Color>

    <Color x:Key="Color.TextPrimary">#E5E7EB</Color>
    <Color x:Key="Color.TextSecondary">#C4C8D1</Color>
    <Color x:Key="Color.TextMuted">#9CA3AF</Color>
    <Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="Color.DisabledBg">#262930</Color>
    <Color x:Key="Color.DisabledFg">#636875</Color>

    <Color x:Key="Color.Success">#5DBB8B</Color>
    <Color x:Key="Color.SuccessSubtle">#1A2E24</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.WarningSubtle">#2D220D</Color>
    <Color x:Key="Color.Error">#F07777</Color>
    <Color x:Key="Color.Danger">#F07777</Color>
    <Color x:Key="Color.DangerSubtle">#361D20</Color>

    <!-- Core Semantic Brushes -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Side" Color="{StaticResource Color.Side}" />
    <SolidColorBrush x:Key="Brush.Rail" Color="{StaticResource Color.Rail}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.SurfaceTone" Color="{StaticResource Color.SurfaceTone}" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.Side}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.PrimarySubtle" Color="{StaticResource Color.PrimarySubtle}" />
    <SolidColorBrush x:Key="Brush.PrimaryBorder" Color="{StaticResource Color.PrimaryBorder}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}" />
    <SolidColorBrush x:Key="Brush.DisabledBg" Color="{StaticResource Color.DisabledBg}" />
    <SolidColorBrush x:Key="Brush.DisabledFg" Color="{StaticResource Color.DisabledFg}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="{StaticResource Color.SuccessSubtle}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="{StaticResource Color.WarningSubtle}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{StaticResource Color.DangerSubtle}" />
</ResourceDictionary>

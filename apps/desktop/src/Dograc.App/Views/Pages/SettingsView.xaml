<UserControl x:Class="Dograc.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Dograc.Core.Theme;assembly=Dograc.Core"
             Background="{DynamicResource Brush.Canvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="860" HorizontalAlignment="Stretch" Margin="36,28,36,40">
            <StackPanel HorizontalAlignment="Stretch">
            <!-- Section Header -->
            <Border BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding PageDescription}"
                               Style="{StaticResource Text.Caption}"
                               FontSize="13"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- APPEARANCE SECTION (3 Visual Mini-Preview Theme Cards) -->
            <StackPanel Visibility="{Binding IsAppearanceSection, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,24,0,0">
                <TextBlock Text="테마" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Text="작업 환경에 맞는 색상 테마를 선택합니다. 변경 즉시 모든 화면에 반영됩니다."
                           Style="{StaticResource Text.Caption}"
                           FontSize="13"
                           Margin="0,4,0,18" />

                <WrapPanel>
                    <!-- System Theme Card -->
                    <Button Command="{Binding SetThemeCommand}"
                            CommandParameter="{x:Static theme:AppThemeMode.System}"
                            Width="168"
                            Margin="0,0,16,16"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CardBd"
                                        CornerRadius="8"
                                        Padding="10"
                                        SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystemTheme}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Split Light/Dark Mini Preview -->
                                        <Border Height="82" CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FFFFFF">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#E1E4E9" BorderThickness="0,0,1,0" />
                                                        <StackPanel Grid.Column="1" Margin="6,10,6,6">
                                                            <Border Height="6" Width="32" HorizontalAlignment="Left" CornerRadius="2" Background="#5055B1" />
                                                            <Border Height="4" CornerRadius="2" Background="#E1E4E9" Margin="0,6,0,0" />
                                                            <Border Height="4" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="#E1E4E9" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="1" Background="#181A1F">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#202228" BorderBrush="#343740" BorderThickness="0,0,1,0" />
                                                        <StackPanel Grid.Column="1" Margin="6,10,6,6">
                                                            <Border Height="6" Width="32" HorizontalAlignment="Left" CornerRadius="2" Background="#9296EA" />
                                                            <Border Height="4" CornerRadius="2" Background="#343740" Margin="0,6,0,0" />
                                                            <Border Height="4" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="#343740" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="System"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Margin="2,10,0,2" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Light Theme Card -->
                    <Button Command="{Binding SetThemeCommand}"
                            CommandParameter="{x:Static theme:AppThemeMode.Light}"
                            Width="168"
                            Margin="0,0,16,16"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Padding="10" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Height="82" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E1E4E9" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#E1E4E9" BorderThickness="0,0,1,0">
                                                    <StackPanel Margin="6,10">
                                                        <Border Height="6" CornerRadius="2" Background="#5055B1" />
                                                        <Border Height="4" CornerRadius="2" Background="#D5D8E0" Margin="0,6,0,0" />
                                                        <Border Height="4" CornerRadius="2" Background="#E1E4E9" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,12">
                                                    <Border Height="7" Width="54" HorizontalAlignment="Right" CornerRadius="3" Background="#E8E9F6" />
                                                    <Border Height="5" CornerRadius="2" Background="#24262E" Opacity="0.22" Margin="0,10,12,0" />
                                                    <Border Height="5" CornerRadius="2" Background="#24262E" Opacity="0.14" Margin="0,5,24,0" />
                                                    <Border Height="14" CornerRadius="4" BorderBrush="#E1E4E9" BorderThickness="1" Margin="0,12,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Light"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Margin="2,10,0,2" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Dark Theme Card -->
                    <Button Command="{Binding SetThemeCommand}"
                            CommandParameter="{x:Static theme:AppThemeMode.Dark}"
                            Width="168"
                            Margin="0,0,0,16"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Padding="10" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Height="82" CornerRadius="6" Background="#181A1F" BorderBrush="#343740" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#202228" BorderBrush="#343740" BorderThickness="0,0,1,0">
                                                    <StackPanel Margin="6,10">
                                                        <Border Height="6" CornerRadius="2" Background="#9296EA" />
                                                        <Border Height="4" CornerRadius="2" Background="#484C58" Margin="0,6,0,0" />
                                                        <Border Height="4" CornerRadius="2" Background="#343740" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,12">
                                                    <Border Height="7" Width="54" HorizontalAlignment="Right" CornerRadius="3" Background="#30334E" />
                                                    <Border Height="5" CornerRadius="2" Background="#E5E7EB" Opacity="0.25" Margin="0,10,12,0" />
                                                    <Border Height="5" CornerRadius="2" Background="#E5E7EB" Opacity="0.14" Margin="0,5,24,0" />
                                                    <Border Height="14" CornerRadius="4" BorderBrush="#343740" BorderThickness="1" Margin="0,12,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Dark"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Margin="2,10,0,2" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- GENERAL SECTION -->
            <StackPanel Visibility="{Binding IsGeneralSection, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,24,0,0">
                <TextBlock Text="일반 동작" Style="{StaticResource Text.SectionTitle}" />
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,1"
                        Margin="0,14,0,0"
                        Padding="0,16">
                    <CheckBox IsChecked="{Binding StopManagedServicesOnExit}"
                              Content="앱 종료 시 dograc이 직접 실행한(Managed) 백엔드 서비스 자동 중지" />
                </Border>
            </StackPanel>

            <!-- LOCAL ENVIRONMENT SECTION -->
            <StackPanel Visibility="{Binding IsLocalEnvSection, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,24,0,0">
                <TextBlock Text="로컬 실행 환경" Style="{StaticResource Text.SectionTitle}" />
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FastAPI Base URL" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding ApiBaseUrl}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="프로젝트 루트 경로" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProjectRoot}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,14">
                            <CheckBox IsChecked="{Binding StopManagedServicesOnExit}"
                                      Content="종료 시 앱 관리 서비스(Managed) 정리 (외부 실행 Docker/Ollama는 유지)" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- UPDATES SECTION -->
            <StackPanel Visibility="{Binding IsUpdatesSection, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,24,0,0">
                <TextBlock Text="애플리케이션 업데이트" Style="{StaticResource Text.SectionTitle}" />
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,1"
                        Margin="0,14,0,0"
                        Padding="0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentVersionLabel}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <Border Background="{DynamicResource Brush.SurfaceTone}"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UpdateModeBadge}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatusMessage}"
                                           Style="{StaticResource Text.Caption}"
                                           FontSize="13"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Secondary}"
                                        Content="업데이트 확인"
                                        IsEnabled="{Binding IsNotCheckingUpdate}"
                                        Command="{Binding CheckForUpdatesCommand}" />
                                <Button Style="{StaticResource Button.Primary}"
                                        Content="지금 설치"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"
                                        IsEnabled="{Binding IsNotInstallingUpdate}"
                                        Command="{Binding InstallUpdateCommand}" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,14,0,0"
                                     Value="{Binding DownloadProgressPercent}"
                                     Foreground="{DynamicResource Brush.Primary}"
                                     Background="{DynamicResource Brush.SurfaceTone}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsInstallingUpdate, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding ReleaseNotes}"
                                   Visibility="{Binding ReleaseNotes, Converter={StaticResource StringNotEmptyToVisibility}}"
                                   FontSize="12.5"
                                   LineHeight="20"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ABOUT SECTION -->
            <StackPanel Visibility="{Binding IsAboutSection, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/dograc;component/Assets/dograc.png"
                           Width="44" Height="44"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="dograc Desktop" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding CurrentVersionLabel}" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="로컬 문서 기반 RAG 질의응답 및 인용 검증 워크스페이스. FastAPI · Qdrant · PostgreSQL · Ollama 로컬 환경에서 모든 문서를 안전하게 처리합니다."
                           FontSize="13.5"
                           LineHeight="22"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" />

                <Button Style="{StaticResource Button.Link}"
                        HorizontalAlignment="Left"
                        Margin="0,14,0,0"
                        Padding="0,4"
                        Content="GitHub Releases 페이지 열기 ↗"
                        Command="{Binding OpenReleasePageCommand}" />
            </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

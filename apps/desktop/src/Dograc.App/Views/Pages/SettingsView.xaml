<UserControl x:Class="Dograc.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Dograc.Core.Theme;assembly=Dograc.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="740" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.TitleM}" />
                <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Theme -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="화면 테마" Style="{StaticResource Text.TitleS}" />
                    <TextBlock Text="선택한 테마는 로컬 설정 파일에 영속 저장되며 다음 실행 시 자동 적용됩니다."
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="System"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="{x:Static theme:AppThemeMode.System}"
                                Margin="0,0,8,0" />
                        <Button Content="Light"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="{x:Static theme:AppThemeMode.Light}"
                                Margin="0,0,8,0" />
                        <Button Content="Dark"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding SetThemeCommand}"
                                CommandParameter="{x:Static theme:AppThemeMode.Dark}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Service Shutdown Policy -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="로컬 서비스 종료 정책" Style="{StaticResource Text.TitleS}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding StopManagedServicesOnExit}"
                              Foreground="{DynamicResource Brush.TextPrimary}"
                              FontSize="13"
                              Content="앱 종료 시 dograc이 시작한(Managed) 백엔드·Docker·Ollama 프로세스를 자동 정리합니다." />
                    <TextBlock Text="외부에서 이미 실행 중이던(External) 서비스는 이 설정과 무관하게 항상 유지됩니다."
                               Style="{StaticResource Text.Caption}"
                               Margin="22,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Runtime & Velopack One-Click Updates -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="애플리케이션 정보 및 자동 업데이트" Style="{StaticResource Text.TitleS}" />
                                <Border Background="{DynamicResource Brush.PrimarySubtle}"
                                        BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                                        BorderThickness="{StaticResource Border.Hairline}"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        Padding="7,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateModeBadge}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Primary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentVersionLabel, StringFormat='현재 버전: {0}'}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Primary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="업데이트 확인"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsNotCheckingUpdate}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding ApiBaseUrl, StringFormat='백엔드 API: {0}'}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding ProjectRoot, StringFormat='프로젝트 경로: {0}'}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="0,2,0,10" />

                    <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="{StaticResource Border.Hairline}"
                            CornerRadius="{StaticResource Radius.Small}"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding UpdateStatusMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextWrapping="Wrap" />

                            <ProgressBar Value="{Binding DownloadProgressPercent}"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,8,0,0"
                                         Foreground="{DynamicResource Brush.Primary}"
                                         Background="{DynamicResource Brush.Border}"
                                         Visibility="{Binding IsInstallingUpdate, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,8,0,0">
                                <TextBlock Text="{Binding ReleaseNotes}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="지금 업데이트 설치 및 재시작"
                                            Style="{StaticResource Button.Primary}"
                                            Command="{Binding InstallUpdateCommand}"
                                            Visibility="{Binding CanAutoInstallUpdate, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{Binding IsNotInstallingUpdate}"
                                            Margin="0,0,8,0" />
                                    <Button Content="GitHub 릴리스 페이지 열기"
                                            Style="{StaticResource Button.Secondary}"
                                            Command="{Binding OpenReleasePageCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

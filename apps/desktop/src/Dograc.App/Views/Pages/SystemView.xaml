<UserControl x:Class="Dograc.App.Views.Pages.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="32,28,32,36">
            <!-- Header + Service Action Toolbar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="System" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding OperationSummary}"
                               Style="{StaticResource Text.Caption}"
                               FontSize="13"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="새로고침"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding RefreshStatusesCommand}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="서비스 시작"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding StartAllCommand}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="관리 서비스 중지"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding StopManagedCommand}" />
                    <Button Style="{StaticResource Button.Ghost}"
                            Content="환경 진단"
                            Margin="6,0,0,0"
                            Command="{Binding OpenSetupWizardCommand}" />
                </StackPanel>
            </Grid>

            <!-- Flat Service Status Table -->
            <StackPanel Margin="0,24,0,0">
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,1"
                        Height="36"
                        Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="서비스" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="상태" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="세부 정보 및 안내" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="소유권" Style="{StaticResource Text.SidebarLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    MinHeight="50"
                                    Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding ErrorCode}"
                                                   Visibility="{Binding ErrorCode, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding State, Converter={StaticResource ServiceStateToBrush}}"
                                                 Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DetailMessage}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ActionHint}"
                                                   Visibility="{Binding ActionHint, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding OwnershipLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Output Log & Diagnostics Toolbar -->
            <Grid Margin="0,32,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Output &amp; Diagnostics" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="120"
                              Height="34"
                              ItemsSource="{Binding LogServiceFilters}"
                              SelectedItem="{Binding SelectedLogServiceFilter}"
                              ToolTip="서비스 필터" />
                    <ComboBox Width="110"
                              Height="34"
                              Margin="6,0,0,0"
                              ItemsSource="{Binding LogLevelFilters}"
                              SelectedItem="{Binding SelectedLogLevelFilter}"
                              ToolTip="로그 레벨 필터" />
                    <TextBox Style="{StaticResource Input.Hairline}"
                             Width="170"
                             Height="34"
                             MinHeight="34"
                             Margin="6,0,0,0"
                             Tag="로그 검색..."
                             Text="{Binding LogSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Height="34"
                            Margin="8,0,0,0"
                            Content="복사"
                            Command="{Binding CopyLogsCommand}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Height="34"
                            Margin="6,0,0,0"
                            Content="로그 파일"
                            Command="{Binding OpenLogFileCommand}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Height="34"
                            Margin="6,0,0,0"
                            Content="진단 보고서"
                            Command="{Binding ExportDiagnosticReportCommand}" />
                    <Button Style="{StaticResource Button.Ghost}"
                            Height="34"
                            Margin="4,0,0,0"
                            Content="지우기"
                            Command="{Binding ClearLogsCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Brush.Side}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Height="300">
                <TextBox Text="{Binding FilteredLogText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

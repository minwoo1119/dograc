<UserControl x:Class="Dograc.App.Views.Pages.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="32,28,32,40">
            <FrameworkElement x:Name="ModelsPageProxy" Visibility="Collapsed" />

            <!-- Page Header -->
            <TextBlock Text="Models" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="로컬 Ollama 서버를 연결하고 설치된 LLM 모델을 탐색·선택합니다."
                       Style="{StaticResource Text.Caption}"
                       FontSize="13"
                       Margin="0,6,0,0" />

            <!-- SECTION 1: 설치된 모델 -->
            <Grid Margin="0,28,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="설치된 모델" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Secondary}"
                        Content="연결 테스트 / 새로고침"
                        IsEnabled="{Binding IsNotBusy}"
                        Command="{Binding TestAndRefreshModelsCommand}" />
            </Grid>

            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Visibility="{Binding HasNoInstalledModels, Converter={StaticResource BoolToVisibility}}"
                               Text="감지된 로컬 모델이 없습니다. 상단 [연결 테스트 / 새로고침]을 눌러 Ollama 모델 목록을 불러오세요."
                               FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="8,16,8,16" />

                    <ItemsControl ItemsSource="{Binding InstalledModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Text="{Binding MetaLabel}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{DynamicResource Brush.Success}"
                                                         Margin="0,0,6,0" />
                                                <TextBlock Text="사용 중"
                                                           FontSize="12.5"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource Brush.Success}" />
                                            </StackPanel>

                                            <Button Style="{StaticResource Button.Secondary}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    Content="이 모델 사용"
                                                    Visibility="{Binding IsNotActive, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.SelectInstalledModelCommand, Source={x:Reference ModelsPageProxy}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- SECTION 2: 연결 설정 -->
            <Border BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Margin="0,32,0,0"
                    Padding="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="연결 설정" Style="{StaticResource Text.SectionTitle}" />
                    <TextBlock Text="로컬 Ollama API 엔드포인트와 기본 생성 모델을 지정합니다."
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ollama Endpoint URL" Style="{StaticResource Text.SidebarLabel}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource Input.Hairline}"
                                     Tag="http://localhost:11434"
                                     Text="{Binding OllamaEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="기본 모델명" Style="{StaticResource Text.SidebarLabel}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource Input.Hairline}"
                                     Tag="qwen2.5:7b"
                                     Text="{Binding SelectedModelName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Style="{StaticResource Button.Primary}"
                                Content="설정 저장"
                                VerticalAlignment="Bottom"
                                Command="{Binding SaveModelSettingsCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding ConnectionMessage}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- SECTION 3: 추천 모델 -->
            <Border BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Margin="0,32,0,0"
                    Padding="0,24,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="추천 모델" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CopiedNotice}"
                                   Visibility="{Binding CopiedNotice, Converter={StaticResource StringNotEmptyToVisibility}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding RecommendedModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <Border Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}"
                                                            Background="{DynamicResource Brush.Selected}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="추천"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource Brush.Accent}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Command}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <Button Style="{StaticResource Button.Secondary}"
                                                        Height="30"
                                                        Padding="10,0"
                                                        FontSize="12"
                                                        Content="명령어 복사"
                                                        Command="{Binding DataContext.CopyInstallCommandCommand, Source={x:Reference ModelsPageProxy}}"
                                                        CommandParameter="{Binding Command}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

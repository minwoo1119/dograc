<UserControl x:Class="Dograc.App.Views.Pages.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="820" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.TitleM}" />
                <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Endpoint & Active Model Configuration -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="로컬 Ollama 연결 설정" Style="{StaticResource Text.TitleS}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ollama 엔드포인트 URL" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Hairline}"
                                     Text="{Binding OllamaEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="현재 활성 모델명" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Hairline}"
                                     Text="{Binding SelectedModelName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Content="연결 테스트 및 모델 새로고침"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding TestAndRefreshModelsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,8,0" />
                        <Button Content="설정 저장"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding SaveModelSettingsCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>

                    <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="{StaticResource Border.Hairline}"
                            CornerRadius="{StaticResource Radius.Small}"
                            Padding="10,7">
                        <TextBlock Text="{Binding ConnectionMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Detected Installed Local Models -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="감지된 로컬 Ollama 모델" Style="{StaticResource Text.TitleS}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding InstalledModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="{StaticResource Border.Hairline}"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Content="이 모델 사용"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding DataContext.SelectInstalledModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Padding="10,4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recommended Model Install Guide -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="추천 로컬 모델 설치 명령어" Style="{StaticResource Text.TitleS}" />
                        <TextBlock Text="{Binding CopiedNotice}"
                                   Visibility="{Binding CopiedNotice, Converter={StaticResource StringNotEmptyToVisibility}}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecommendedModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="{StaticResource Border.Hairline}"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <Border Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}"
                                                        Background="{DynamicResource Brush.PrimarySubtle}"
                                                        BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                                                        BorderThickness="{StaticResource Border.Hairline}"
                                                        CornerRadius="{StaticResource Radius.Small}"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="추천" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Command}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.Primary}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="명령어 복사"
                                                Style="{StaticResource Button.Secondary}"
                                                Command="{Binding DataContext.CopyInstallCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Command}"
                                                VerticalAlignment="Center"
                                                Padding="10,5" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

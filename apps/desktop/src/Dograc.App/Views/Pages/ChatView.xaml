<UserControl x:Class="Dograc.App.Views.Pages.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.TitleM}" />
            <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{StaticResource Border.Hairline}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="문서 기반 질의응답 준비 완료"
                           Style="{StaticResource Text.TitleS}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Phase 4~5에서 대화 세션, Markdown 답변 렌더링, 인라인 인용 및 Evidence 패널 연동이 연결됩니다."
                           Style="{StaticResource Text.BodyM}"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{StaticResource Border.Hairline}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource Input.Hairline}"
                         AcceptsReturn="True"
                         MinHeight="40"
                         MaxHeight="120"
                         IsEnabled="False"
                         Text="서비스 연결 및 대화 세션 선택 후 질문할 수 있습니다." />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Primary}"
                        Content="전송"
                        IsEnabled="False"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

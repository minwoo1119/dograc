<UserControl x:Class="Dograc.App.Views.Pages.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dograc.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chat Header: Conversation Title & Model Selector -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveConversationTitle}"
                               Style="{StaticResource Text.TitleS}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="{StaticResource Border.Hairline}"
                            CornerRadius="{StaticResource Radius.Small}"
                            Padding="7,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveWorkspaceName}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="모델:"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              Text="{Binding SelectedModelName, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Width="165"
                              Height="28"
                              FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Message Thread -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel MaxWidth="900">
                <!-- Empty State -->
                <Border Visibility="{Binding IsEmptyThread, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Hairline}"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="28,24"
                        Margin="0,36,0,0">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="문서 기반 질의응답"
                                   Style="{StaticResource Text.TitleM}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="업로드된 문서의 문맥을 바탕으로 근거와 함께 답변합니다. 답변의 [파일명, p.숫자] 인용을 클릭하면 우측 Evidence 패널에서 원문 발췌와 유사도를 확인할 수 있습니다."
                                   Style="{StaticResource Text.BodyM}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Persisted Messages -->
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,14">
                                <!-- User Message (Right Aligned, Subtle Indigo Tint) -->
                                <StackPanel Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Right"
                                            MaxWidth="720">
                                    <TextBlock Text="{Binding SenderLabel}"
                                               Style="{StaticResource Text.Caption}"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,2,4" />
                                    <Border Background="{DynamicResource Brush.PrimarySubtle}"
                                            BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                                            BorderThickness="{StaticResource Border.Hairline}"
                                            CornerRadius="8,2,8,8"
                                            Padding="14,10">
                                        <controls:MarkdownFlowControl MarkdownText="{Binding Content}"
                                                                      EnableCitations="False" />
                                    </Border>
                                </StackPanel>

                                <!-- Assistant Message (Left Aligned, Reading-First White Surface) -->
                                <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Left"
                                            MaxWidth="780">
                                    <TextBlock Text="{Binding SenderLabel}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="2,0,0,4" />
                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="{StaticResource Border.Hairline}"
                                            CornerRadius="2,8,8,8"
                                            Padding="16,12">
                                        <StackPanel>
                                            <controls:MarkdownFlowControl MarkdownText="{Binding Content}"
                                                                          EnableCitations="True"
                                                                          CitationClickedCommand="{Binding OpenCitationCommand}" />

                                            <!-- Citation Chips & Evidence Trigger Footer -->
                                            <Border Visibility="{Binding ShowAssistantFooter, Converter={StaticResource BoolToVisibility}}"
                                                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,10,0,0"
                                                    Padding="0,8,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="참고한 문서 출처"
                                                                   Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Content="답변 근거 및 출처 분석 보기 →"
                                                                Visibility="{Binding HasTrace, Converter={StaticResource BoolToVisibility}}"
                                                                Command="{Binding OpenTraceCommand}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.Primary}"
                                                                HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Citations}"
                                                                  Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Margin="0,0,6,6"
                                                                        Cursor="Hand">
                                                                    <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                                            BorderThickness="{StaticResource Border.Hairline}"
                                                                            CornerRadius="{StaticResource Radius.Small}"
                                                                            Padding="8,3">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding FileName}"
                                                                                       FontSize="11.5"
                                                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                                                            <TextBlock Text="{Binding DisplayPage}"
                                                                                       FontFamily="{StaticResource Font.Mono}"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource Brush.Primary}"
                                                                                       Margin="6,0,0,0" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Optimistic User Message -->
                <StackPanel Visibility="{Binding OptimisticUserMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                            HorizontalAlignment="Right"
                            MaxWidth="720"
                            Margin="0,0,0,12">
                    <TextBlock Text="사용자" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,0,2,4" />
                    <Border Background="{DynamicResource Brush.PrimarySubtle}"
                            BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                            BorderThickness="{StaticResource Border.Hairline}"
                            CornerRadius="8,2,8,8"
                            Padding="14,10">
                        <TextBlock Text="{Binding OptimisticUserMessage}"
                                   Style="{StaticResource Text.BodyM}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </Border>
                </StackPanel>

                <!-- Assistant Generating Indicator + Stop Button -->
                <Border Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Hairline}"
                        CornerRadius="2,8,8,8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="문서를 검색하고 근거 기반 답변을 생성하는 중입니다..."
                                   Style="{StaticResource Text.BodyM}"
                                   VerticalAlignment="Center" />
                        <Button Content="생성 중지"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding StopGenerationCommand}"
                                Padding="10,4"
                                Margin="12,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Error / Cancelled Card with Retry & Restore -->
                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                        HorizontalAlignment="Left"
                        MaxWidth="560"
                        Background="{DynamicResource Brush.DangerSubtle}"
                        BorderBrush="{DynamicResource Brush.Danger}"
                        BorderThickness="{StaticResource Border.Hairline}"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="요청을 완료하지 못했습니다"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Danger}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding FailedQuestion, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <Button Content="다시 시도"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding RetryFailedCommand}"
                                    Padding="10,4"
                                    Margin="0,0,6,0" />
                            <Button Content="입력창으로 복원"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding RestoreFailedInputCommand}"
                                    Padding="10,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Multiline Input Area -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel MaxWidth="900">
                <!-- Lightweight Markdown Formatting Bar -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="서식:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Content="B" FontWeight="Bold" Style="{StaticResource Button.Secondary}" Padding="7,2" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding InsertMarkdownSnippetCommand}" CommandParameter="**강조**" />
                        <Button Content="I" FontStyle="Italic" Style="{StaticResource Button.Secondary}" Padding="7,2" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding InsertMarkdownSnippetCommand}" CommandParameter="*기울임*" />
                        <Button Content="Code" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Button.Secondary}" Padding="7,2" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding InsertMarkdownSnippetCommand}" CommandParameter="`코드`" />
                        <Button Content="• 목록" Style="{StaticResource Button.Secondary}" Padding="7,2" FontSize="11"
                                Command="{Binding InsertMarkdownSnippetCommand}" CommandParameter="- " />
                    </StackPanel>
                    <TextBlock Text="Enter 전송 · Shift+Enter 줄바꿈"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ChatInputBox"
                             Grid.Column="0"
                             Style="{StaticResource Input.Hairline}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="44"
                             MaxHeight="140"
                             IsEnabled="{Binding HasWorkspace}"
                             PreviewKeyDown="OnChatInputPreviewKeyDown" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Button Content="전송"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding SendMessageCommand}"
                                Visibility="{Binding IsNotGenerating, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{Binding HasWorkspace}"
                                Height="44"
                                Padding="18,0" />
                        <Button Content="중지"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding StopGenerationCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"
                                Height="44"
                                Padding="18,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

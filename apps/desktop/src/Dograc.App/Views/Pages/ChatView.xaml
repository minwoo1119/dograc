<UserControl x:Class="Dograc.App.Views.Pages.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dograc.App.Controls"
             Background="{DynamicResource Brush.Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chat Header (60 DIP, 1px hairline bottom border) -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Canvas}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveWorkspaceName, StringFormat={}{0} / 대화}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ActiveConversationTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModelName}"
                          Height="34"
                          MinWidth="148"
                          FontSize="13"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          ToolTip="활성 LLM 모델 선택" />
            </Grid>
        </Border>

        <!-- Reading-First Message Thread (MaxWidth 720 DIP, no assistant outer card) -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource Brush.Canvas}">
            <Grid MaxWidth="720"
                  HorizontalAlignment="Stretch"
                  Margin="28,28,28,20">
                <StackPanel>
                    <!-- Empty Thread State -->
                    <StackPanel Visibility="{Binding IsEmptyThread, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center"
                                Margin="0,96,0,48">
                        <Image Source="pack://application:,,,/dograc;component/Assets/dograc.png"
                               Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                        <TextBlock Text="무엇을 도와드릴까요?"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="업로드된 문서를 기반으로 출처와 함께 정확하게 답변합니다."
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Messages List -->
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- User Message: Right-aligned subtle Selected tint (radius 12, max-width 640) -->
                                    <Border Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Right"
                                            MaxWidth="640"
                                            Background="{DynamicResource Brush.Selected}"
                                            CornerRadius="12"
                                            Padding="16,12"
                                            Margin="0,0,0,28">
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="15"
                                                   LineHeight="24"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Border>

                                    <!-- Assistant Message: Editorial flat canvas layout (NO outer card!) -->
                                    <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}"
                                                Margin="0,0,0,32">
                                        <!-- Assistant Header Row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="pack://application:,,,/dograc;component/Assets/dograc.png"
                                                       Width="24" Height="24"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Margin="0,0,8,0" />
                                                <TextBlock Text="dograc"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ModelName}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.IconGhost}"
                                                        Width="28" Height="28"
                                                        ToolTip="답변 복사"
                                                        Command="{Binding CopyCommand}">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource Icon.Copy}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Width="24" Height="24" />
                                                    </Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource Button.IconGhost}"
                                                        Width="28" Height="28"
                                                        Margin="2,0,0,0"
                                                        ToolTip="다시 생성"
                                                        Visibility="{Binding CanRegenerate, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding RegenerateCommand}">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource Icon.Refresh}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Width="24" Height="24" />
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Editorial Markdown Content with superscript [1], [2] citations -->
                                        <controls:MarkdownFlowControl MarkdownText="{Binding Content}"
                                                                      EnableCitations="True"
                                                                      CitationClickedCommand="{Binding OpenCitationCommand}" />

                                        <!-- Subtle Hairline Sources Footer -->
                                        <Border Visibility="{Binding ShowAssistantFooter, Converter={StaticResource BoolToVisibility}}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0,1,0,0"
                                                Margin="0,18,0,0"
                                                Padding="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SourcesSummaryLabel}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource Button.Link}"
                                                        Content="근거 보기 →"
                                                        FontSize="12"
                                                        FontWeight="Medium"
                                                        Command="{Binding OpenTraceCommand}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Optimistic User Message (while generating) -->
                    <Border Visibility="{Binding OptimisticUserMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                            HorizontalAlignment="Right"
                            MaxWidth="640"
                            Background="{DynamicResource Brush.Selected}"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,24">
                        <TextBlock Text="{Binding OptimisticUserMessage}"
                                   FontSize="15"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </Border>

                    <!-- Generating Indicator -->
                    <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Source="pack://application:,,,/dograc;component/Assets/dograc.png"
                                   Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0,0,8,0" />
                            <TextBlock Text="dograc"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedModelName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="문서에서 근거를 검색하고 답변을 생성하고 있습니다..."
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>

                    <!-- Inline Warning Banner when workspace has no indexed documents yet (RAG-002) -->
                    <Border Visibility="{Binding ShowNoIndexedDocsHint, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource Brush.WarningSubtle}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="색인 완료된 문서가 없습니다 (RAG-002)"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="현재 워크스페이스에 검색 가능한 문서가 없어 근거 기반 답변을 제공할 수 없습니다. PDF 또는 TXT 문서를 먼저 업로드해 주세요."
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Secondary}"
                                    Height="30"
                                    Padding="10,0"
                                    Margin="12,0,0,0"
                                    Content="+ 파일 추가"
                                    Command="{Binding RequestAttachDocumentCommand}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Structured ErrorCard pinned above Composer with compact max height for small windows -->
        <Border Grid.Row="2"
                Visibility="{Binding ActiveError, Converter={StaticResource NullToVisibility}}"
                Background="{DynamicResource Brush.Canvas}"
                Padding="28,6,28,4">
            <ScrollViewer MaxWidth="720"
                          MaxHeight="195"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <controls:ErrorCardControl Error="{Binding ActiveError}"
                                           ActionCommand="{Binding ExecuteErrorActionCommand}"
                                           DismissCommand="{Binding DismissErrorCommand}" />
            </ScrollViewer>
        </Border>

        <!-- Bottom Composer (MaxWidth 720, min-height 96, radius 12) -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Canvas}"
                Padding="28,6,28,20">
            <Border MaxWidth="720"
                    MinHeight="96"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource Brush.Canvas}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12,12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Borderless Multiline Input -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="문서에 대해 질문하세요..."
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="2,2,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="ChatInputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnChatInputPreviewKeyDown"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="44"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 CaretBrush="{DynamicResource Brush.Accent}"
                                 FontFamily="{StaticResource Font.Primary}"
                                 FontSize="14"
                                 Padding="0,1,0,0" />
                    </Grid>

                    <!-- Composer Footer Controls -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: + attach button + indexed docs status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.IconGhost}"
                                    Width="30" Height="30"
                                    ToolTip="문서 파일 추가"
                                    Command="{Binding RequestAttachDocumentCommand}">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource Icon.Plus}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="24" Height="24" />
                                </Viewbox>
                            </Button>

                            <Button Style="{StaticResource Button.Ghost}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="4,0,0,0"
                                    Command="{Binding RequestOpenDocumentsTabCommand}">
                                <TextBlock Text="{Binding IndexedDocumentsLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Active Model caption + 34x34 Send/Stop Button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedModelName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <!-- Send Button (34x34, radius 8, Primary Indigo) -->
                            <Button Visibility="{Binding IsNotGenerating, Converter={StaticResource BoolToVisibility}}"
                                    IsEnabled="{Binding HasWorkspace}"
                                    Command="{Binding SendMessageCommand}"
                                    Width="34" Height="34"
                                    Cursor="Hand"
                                    ToolTip="{Binding SendButtonTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Brush.Primary}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="{StaticResource Icon.Send}"
                                                      Stroke="{DynamicResource Brush.TextOnPrimary}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="24" Height="24" />
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryPressed}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DisabledBg}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Stop Button (34x34, radius 8, Error Red) -->
                            <Button Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding StopGenerationCommand}"
                                    Width="34" Height="34"
                                    Cursor="Hand"
                                    ToolTip="생성 중지"
                                    FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource Brush.Error}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <Viewbox Width="13" Height="13">
                                                <Path Data="{StaticResource Icon.Stop}"
                                                      Fill="{DynamicResource Brush.TextOnPrimary}"
                                                      Width="24" Height="24" />
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

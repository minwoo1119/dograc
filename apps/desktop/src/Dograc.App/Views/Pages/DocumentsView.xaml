<UserControl x:Class="Dograc.App.Views.Pages.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.TitleM}" />
                    <Border Background="{DynamicResource Brush.PrimarySubtle}"
                            BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                            BorderThickness="{StaticResource Border.Hairline}"
                            CornerRadius="{StaticResource Radius.Small}"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveWorkspaceName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Primary}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="새로고침"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Margin="0,0,6,0" />
                <Button Content="파일 선택 업로드"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding BrowseAndUploadCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </StackPanel>
        </Grid>

        <!-- Drag & Drop Upload Zone -->
        <Border Grid.Row="1"
                AllowDrop="True"
                Drop="OnFilesDrop"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="{StaticResource Border.Hairline}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="20,16"
                Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="PDF 또는 TXT 파일을 여기에 끌어다 놓아 업로드하세요"
                           Style="{StaticResource Text.TitleS}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Error Banner -->
        <Border Grid.Row="2"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                Background="{DynamicResource Brush.DangerSubtle}"
                BorderBrush="{DynamicResource Brush.Danger}"
                BorderThickness="{StaticResource Border.Hairline}"
                CornerRadius="{StaticResource Radius.Small}"
                Padding="10,7"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Documents List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Documents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="{StaticResource Border.Hairline}"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceFileName}" Style="{StaticResource Text.TitleS}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                                 Fill="{Binding Status, Converter={StaticResource DocumentStatusToBrush}}" />
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='업로드: {0:yyyy-MM-dd HH:mm}'}"
                                                   Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="색인 시작"
                                            Style="{StaticResource Button.Primary}"
                                            Visibility="{Binding CanTriggerProcess, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.ProcessDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5"
                                            Margin="0,0,6,0" />
                                    <Button Content="삭제"
                                            Style="{StaticResource Button.Secondary}"
                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

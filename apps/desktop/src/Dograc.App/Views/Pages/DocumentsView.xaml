<UserControl x:Class="Dograc.App.Views.Pages.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dograc.App.Controls"
             Background="{DynamicResource Brush.Canvas}"
             AllowDrop="True"
             Drop="OnFilesDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1200" HorizontalAlignment="Stretch" Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FrameworkElement x:Name="DocsPageProxy" Visibility="Collapsed" />

            <!-- Page Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Documents" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="워크스페이스 문서와 색인 상태를 관리합니다. PDF 또는 TXT 파일을 끌어다 놓아 업로드할 수 있습니다."
                           Style="{StaticResource Text.Caption}"
                           FontSize="13"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Action Toolbar -->
            <Grid Grid.Row="1" Margin="0,22,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource Input.Hairline}"
                         Width="260"
                         Height="36"
                         Tag="문서 이름 검색..."
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Grid.Column="1"
                          Width="136"
                          Height="36"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}"
                            Content="작업 취소"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,6,0"
                            Command="{Binding CancelCurrentOperationCommand}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="새로고침"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="+ 파일 추가"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding BrowseAndUploadCommand}" />
                </StackPanel>
            </Grid>

            <!-- Multi-Select Batch Action Bar (visible only when rows selected) -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource Brush.Selected}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectionSummaryLabel}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Secondary}"
                                Height="28" Padding="10,0" FontSize="12"
                                Content="선택 재색인"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding ReindexSelectedCommand}" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Height="28" Padding="10,0" FontSize="12"
                                Margin="6,0,0,0"
                                Content="선택 삭제"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding DeleteSelectedCommand}" />
                        <Button Style="{StaticResource Button.Ghost}"
                                Height="28" Padding="8,0" FontSize="12"
                                Margin="4,0,0,0"
                                Content="선택 해제"
                                Command="{Binding ClearSelectionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Flat Hairline Table with Real Metadata & Sorting -->
            <StackPanel Grid.Row="3">
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,1"
                        Height="36"
                        Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding AreAllSelected, Mode=OneWay}"
                                  Command="{Binding ToggleSelectAllCommand}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  ToolTip="전체 선택 / 해제" />

                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Padding="0,2" HorizontalAlignment="Left"
                                Command="{Binding SortByCommand}" CommandParameter="Name" ToolTip="파일명 정렬">
                            <TextBlock Text="파일명 ↕" Style="{StaticResource Text.SidebarLabel}" />
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Padding="0,2" HorizontalAlignment="Left"
                                Command="{Binding SortByCommand}" CommandParameter="Size" ToolTip="크기 정렬">
                            <TextBlock Text="크기 ↕" Style="{StaticResource Text.SidebarLabel}" />
                        </Button>

                        <TextBlock Grid.Column="3" Text="페이지" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="청크" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />

                        <Button Grid.Column="5" Style="{StaticResource Button.Ghost}" Padding="0,2" HorizontalAlignment="Left"
                                Command="{Binding SortByCommand}" CommandParameter="UploadedAt" ToolTip="업로드 일시 정렬">
                            <TextBlock Text="업로드 일시 ↕" Style="{StaticResource Text.SidebarLabel}" />
                        </Button>

                        <Button Grid.Column="6" Style="{StaticResource Button.Ghost}" Padding="0,2" HorizontalAlignment="Left"
                                Command="{Binding SortByCommand}" CommandParameter="Status" ToolTip="상태 정렬">
                            <TextBlock Text="상태 ↕" Style="{StaticResource Text.SidebarLabel}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ItemsControl ItemsSource="{Binding FilteredDocuments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Height="46"
                                    Padding="8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SourceFileName}"
                                               ToolTip="{Binding SourceFileName}"
                                               FontSize="13.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding PageCountLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding ChunkCountLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding UploadedAtLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding Status, Converter={StaticResource DocumentStatusToBrush}}"
                                                 Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   ToolTip="{Binding StatusLabel}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="7"
                                            Style="{StaticResource Button.IconGhost}"
                                            Width="28" Height="28"
                                            HorizontalAlignment="Right"
                                            Click="OnOverflowButtonClick"
                                            ToolTip="문서 작업">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="원문 보기"
                                                          Command="{Binding DataContext.OpenInPreviewCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="색인 다시 시작"
                                                          Command="{Binding DataContext.ProcessDocumentCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="실패 원인 상세 보기"
                                                          Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                                                          Command="{Binding DataContext.InspectDocumentFailureCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="삭제"
                                                          Command="{Binding DataContext.DeleteDocumentCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Viewbox Width="15" Height="15">
                                            <Path Data="{StaticResource Icon.More}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  Width="24" Height="24" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Structured ErrorCard (no duplicate Toast!) + Status Footer -->
            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <controls:ErrorCardControl Visibility="{Binding ActiveError, Converter={StaticResource NullToVisibility}}"
                                           Error="{Binding ActiveError}"
                                           ActionCommand="{Binding ExecuteErrorActionCommand}"
                                           DismissCommand="{Binding DismissErrorCommand}"
                                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Dograc.App.Views.Pages.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dograc.App.Controls"
             Background="{DynamicResource Brush.Canvas}"
             AllowDrop="True"
             Drop="OnFilesDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1200" HorizontalAlignment="Stretch" Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Helper proxy for ContextMenu DataContext binding -->
            <FrameworkElement x:Name="DocsPageProxy" Visibility="Collapsed" />

            <!-- Page Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Documents" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="워크스페이스 문서와 색인 상태를 관리합니다. PDF 또는 TXT 파일을 끌어다 놓아 업로드할 수 있습니다."
                           Style="{StaticResource Text.Caption}"
                           FontSize="13"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Action Toolbar -->
            <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource Input.Hairline}"
                         Width="280"
                         Height="36"
                         Tag="문서 이름 검색..."
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Grid.Column="1"
                          Width="140"
                          Height="36"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="새로고침"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="+ 파일 추가"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding BrowseAndUploadCommand}" />
                </StackPanel>
            </Grid>

            <!-- Flat Hairline Table -->
            <StackPanel Grid.Row="2">
                <!-- Table Header (36 DIP) -->
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,1"
                        Height="36"
                        Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="파일명" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="형식" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="상태" Style="{StaticResource Text.SidebarLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="" />
                    </Grid>
                </Border>

                <!-- Table Rows (46 DIP, flat hairline dividers, hover tint) -->
                <ItemsControl ItemsSource="{Binding FilteredDocuments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Height="46"
                                    Padding="8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SourceFileName}"
                                               FontSize="13.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileFormat}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding Status, Converter={StaticResource DocumentStatusToBrush}}"
                                                 Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Style="{StaticResource Button.IconGhost}"
                                            Width="28" Height="28"
                                            HorizontalAlignment="Right"
                                            Click="OnOverflowButtonClick"
                                            ToolTip="문서 작업">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="원문 보기"
                                                          Command="{Binding DataContext.OpenInPreviewCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="색인 시작"
                                                          Command="{Binding DataContext.ProcessDocumentCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="삭제"
                                                          Command="{Binding DataContext.DeleteDocumentCommand, Source={x:Reference DocsPageProxy}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Viewbox Width="15" Height="15">
                                            <Path Data="{StaticResource Icon.More}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  Width="24" Height="24" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Structured ErrorCard + Status Footer -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <controls:ErrorCardControl Visibility="{Binding ActiveError, Converter={StaticResource NullToVisibility}}"
                                           Error="{Binding ActiveError}"
                                           ActionCommand="{Binding ExecuteErrorActionCommand}"
                                           DismissCommand="{Binding DismissErrorCommand}"
                                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

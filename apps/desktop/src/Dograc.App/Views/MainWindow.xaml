<Window x:Class="Dograc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:nav="clr-namespace:Dograc.Core.Navigation;assembly=Dograc.Core"
        xmlns:models="clr-namespace:Dograc.Core.Models;assembly=Dograc.Core"
        xmlns:err="clr-namespace:Dograc.Core.Errors;assembly=Dograc.Core"
        xmlns:vm="clr-namespace:Dograc.App.ViewModels"
        xmlns:pages="clr-namespace:Dograc.App.Views.Pages"
        Title="dograc"
        Icon="pack://application:,,,/dograc;component/Assets/dograc.ico"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenQuickCommandPaletteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <pages:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <pages:DocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspacesViewModel}">
            <pages:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
            <pages:ModelsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <pages:SystemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsView />
        </DataTemplate>

        <!-- Window Caption Button Style -->
        <Style x:Key="Button.WindowCaption" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.WindowCaption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Error}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Panel Underline Tab Style -->
        <Style x:Key="Button.ContextUnderlineTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="ActiveLine"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- 1. TOP TITLE BAR (44 DIP, Brush.Side) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Side}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Mark -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/dograc;component/Assets/dograc.png"
                               Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0" />
                        <TextBlock Text="dograc"
                                   FontSize="15.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Centered Command Search Trigger (Ctrl+K) -->
                    <Button Grid.Column="1"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenQuickCommandPaletteCommand}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="360"
                            Height="30"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource Brush.Canvas}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Search}"
                                                  Stroke="{DynamicResource Brush.TextMuted}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="24" Height="24" />
                                        </Viewbox>
                                        <TextBlock Grid.Column="1"
                                                   Text="대화, 문서, 설정 검색..."
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource Brush.Side}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Ctrl+K"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Right Utility Controls & Window Caption Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Calm Service Status Indicator -->
                        <Button Style="{StaticResource Button.Ghost}"
                                Height="28"
                                Padding="8,0"
                                Margin="0,0,4,0"
                                Command="{Binding OpenSystemPageCommand}"
                                ToolTip="로컬 서비스 상태 확인 (System)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7"
                                         Fill="{Binding OverallServiceState, Converter={StaticResource ServiceStateToBrush}}"
                                         Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TitleStatusText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Button>

                        <!-- Subtle Update Icon Button (with tiny dot only when update available) -->
                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding InstallOrOpenUpdateCommand}"
                                IsEnabled="{Binding IsNotInstallingUpdate}"
                                ToolTip="{Binding UpdateTooltip}">
                            <Grid Width="20" Height="20">
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Update}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="24" Height="24" />
                                </Viewbox>
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource Brush.Accent}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- Toggle Left Sidebar -->
                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="왼쪽 사이드바 열기/닫기">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource Icon.PanelLeft}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="24" Height="24" />
                            </Viewbox>
                        </Button>

                        <!-- Toggle Right Context Panel -->
                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding ToggleContextPanelCommand}"
                                ToolTip="오른쪽 컨텍스트 패널 열기/닫기">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource Icon.PanelRight}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="24" Height="24" />
                            </Viewbox>
                        </Button>

                        <!-- Theme Toggle -->
                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding CycleThemeCommand}"
                                ToolTip="테마 전환 (Light / Dark)">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource Icon.Theme}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="24" Height="24" />
                            </Viewbox>
                        </Button>

                        <Border Width="1" Height="16"
                                Background="{DynamicResource Brush.Border}"
                                Margin="6,0,2,0" />

                        <!-- Minimize / Maximize / Close -->
                        <Button Style="{StaticResource Button.WindowCaption}" Click="OnMinimizeClick" ToolTip="최소화">
                            <Viewbox Width="11" Height="11">
                                <Path Data="{StaticResource Icon.Minimize}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      Width="24" Height="24" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource Button.WindowCaption}" Click="OnMaximizeRestoreClick" ToolTip="최대화/복원">
                            <Viewbox Width="10" Height="10">
                                <Path Data="{StaticResource Icon.Maximize}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"
                                      Width="24" Height="24" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource Button.WindowClose}" Click="OnCloseClick" ToolTip="닫기">
                            <Viewbox Width="11" Height="11">
                                <Path Data="{StaticResource Icon.Close}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      Width="24" Height="24" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN WORKSPACE SHELL -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="{Binding SidebarColumnWidth, Mode=TwoWay}" />
                    <ColumnDefinition Width="{Binding SidebarSplitterWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding ContextSplitterWidth}" />
                    <ColumnDefinition Width="{Binding ContextColumnWidth, Mode=TwoWay}" />
                </Grid.ColumnDefinitions>

                <!-- 2A. ACTIVITY BAR (52 DIP, Brush.Rail, icon-only 22x22 vector paths) -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Rail}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">
                        <!-- Bottom-Pinned Settings Icon -->
                        <Grid DockPanel.Dock="Bottom" Height="44" Margin="0,0,0,8">
                            <Border Width="3" Height="24"
                                    HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                            <Button Width="38" Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static nav:NavigationPage.Settings}"
                                    ToolTip="Settings"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <Viewbox Width="20" Height="20">
                                                            <Path Data="{StaticResource Icon.Settings}"
                                                                  Stroke="{TemplateBinding Foreground}"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Width="24" Height="24" />
                                                        </Viewbox>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Top 5 Navigation Icons -->
                        <ItemsControl ItemsSource="{Binding TopNavigationItems}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44" Margin="0,1">
                                        <!-- Left 3px Active Accent Bar -->
                                        <Border Width="3" Height="24"
                                                HorizontalAlignment="Left"
                                                CornerRadius="0,2,2,0"
                                                Background="{DynamicResource Brush.Accent}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource MultiEquality}">
                                                                    <Binding Path="Page" />
                                                                    <Binding Path="DataContext.SelectedPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Button Width="38" Height="40"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Page}"
                                                ToolTip="{Binding Tooltip}"
                                                Cursor="Hand"
                                                FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="6">
                                                                    <Viewbox Width="20" Height="20">
                                                                        <Path Data="{Binding Glyph, Converter={StaticResource IconKeyToGeometry}}"
                                                                              Stroke="{TemplateBinding Foreground}"
                                                                              StrokeThickness="1.6"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              Width="24" Height="24" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource MultiEquality}">
                                                                    <Binding Path="Page" />
                                                                    <Binding Path="DataContext.SelectedPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- 2B. CONTEXT-AWARE SIDEBAR (260 DIP, Brush.Side, zero width when collapsed) -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Brush.Side}"
                        Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <!-- CHAT SIDEBAR: Workspace Selector + New Chat + Search + Date-Grouped Flat Rows -->
                        <Grid Visibility="{Binding IsChatPage, Converter={StaticResource BoolToVisibility}}"
                              Margin="14,16,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Workspace Selector -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="WORKSPACE"
                                           Style="{StaticResource Text.SidebarLabel}"
                                           Margin="2,0,0,6" />
                                <ComboBox ItemsSource="{Binding Workspaces}"
                                          SelectedItem="{Binding SelectedWorkspace}"
                                          DisplayMemberPath="Name"
                                          Height="36"
                                          ToolTip="활성 워크스페이스 선택" />
                            </StackPanel>

                            <!-- Primary + 새 대화 Button -->
                            <Button Grid.Row="1"
                                    Style="{StaticResource Button.Primary}"
                                    Content="+ 새 대화"
                                    Height="36"
                                    Margin="0,10,0,0"
                                    Command="{Binding CreateConversationCommand}" />

                            <!-- Conversation Search -->
                            <TextBox Grid.Row="2"
                                     Style="{StaticResource Input.Hairline}"
                                     Height="34"
                                     MinHeight="34"
                                     Margin="0,10,0,10"
                                     Tag="대화 검색..."
                                     Text="{Binding ConversationSearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Flat Date-Grouped Conversation Rows (NO cards!) -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ConversationGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="{Binding Header}"
                                                           Style="{StaticResource Text.SidebarLabel}"
                                                           Margin="8,4,8,6" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6"
                                                                    Height="38"
                                                                    Margin="0,1"
                                                                    Cursor="Hand">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="대화 삭제"
                                                                                  Command="{Binding DataContext.DeleteConversationCommand, Source={x:Reference RootShellProxy}}"
                                                                                  CommandParameter="{Binding Conversation}" />
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Button Grid.Column="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Padding="10,0,4,0"
                                                                            HorizontalContentAlignment="Left"
                                                                            VerticalContentAlignment="Center"
                                                                            Cursor="Hand"
                                                                            Command="{Binding DataContext.SelectConversationRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="13"
                                                                                   TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                                                            <Setter Property="FontWeight" Value="Medium" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Button>

                                                                    <!-- Hover-only subtle delete button -->
                                                                    <Button Grid.Column="1"
                                                                            Width="24" Height="24"
                                                                            Margin="0,0,4,0"
                                                                            ToolTip="대화 삭제"
                                                                            Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding Conversation}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource Button.IconGhost}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Viewbox Width="11" Height="11">
                                                                            <Path Data="{StaticResource Icon.Close}"
                                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                  StrokeThickness="1.8"
                                                                                  StrokeStartLineCap="Round"
                                                                                  Width="24" Height="24" />
                                                                        </Viewbox>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- NON-CHAT CONTEXT-AWARE SIDEBAR (Documents / Workspaces / Models / System / Settings) -->
                        <StackPanel Visibility="{Binding IsNonChatPage, Converter={StaticResource BoolToVisibility}}"
                                    Margin="14,20,14,16">
                            <TextBlock Text="{Binding SidebarSectionTitle}"
                                       Style="{StaticResource Text.SidebarLabel}"
                                       Margin="10,0,0,10" />

                            <ItemsControl ItemsSource="{Binding SidebarMenuItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="36"
                                                Margin="0,1"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectSidebarMenuItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                FocusVisualStyle="{StaticResource FocusVisual.Accent}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="10,0">
                                                                    <ContentPresenter VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="13" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Helper proxy for ContextMenu DataContext binding -->
                        <FrameworkElement x:Name="RootShellProxy" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Sidebar Resizable Splitter (1px Hairline, 0px when hidden) -->
                <GridSplitter Grid.Column="2"
                              Width="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource Brush.Border}"
                              Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}"
                              ResizeDirection="Columns" />

                <!-- 2C. CENTER CANVAS -->
                <Grid Grid.Column="3" Background="{DynamicResource Brush.Canvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Calm Environment Warning Banner (only shown on NeedsSetup / Failed) -->
                    <Border Grid.Row="0"
                            Visibility="{Binding ShowEnvironmentBanner, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource Brush.WarningSubtle}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding BannerMessage}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Style="{StaticResource Button.Secondary}"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="12"
                                        Content="다시 시도"
                                        Visibility="{Binding CanRetryStartup, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding RetryStartupCommand}" />
                                <Button Style="{StaticResource Button.Primary}"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="6,0,0,0"
                                        Content="초기 설정"
                                        Command="{Binding OpenSetupWizardCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active Page View -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" />
                </Grid>

                <!-- Context Panel Splitter (1px Hairline, 0px when hidden) -->
                <GridSplitter Grid.Column="4"
                              Width="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource Brush.Border}"
                              Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}"
                              ResizeDirection="Columns" />

                <!-- 2D. RIGHT CONTEXT PANEL (344 DIP, Brush.Side, zero width when collapsed) -->
                <Border Grid.Column="5"
                        Background="{DynamicResource Brush.Side}"
                        Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Underline Tabs (44 DIP height, 2px Accent underline, NO boxed tabs!) -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                                <Button Content="Documents"
                                        Command="{Binding SelectContextTabCommand}"
                                        CommandParameter="{x:Static models:ContextPanelTab.Documents}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.ContextUnderlineTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDocumentsContextTab}" Value="True">
                                                    <Setter Property="Tag" Value="Active" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Evidence"
                                        Command="{Binding SelectContextTabCommand}"
                                        CommandParameter="{x:Static models:ContextPanelTab.Evidence}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.ContextUnderlineTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEvidenceContextTab}" Value="True">
                                                    <Setter Property="Tag" Value="Active" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Preview"
                                        Margin="0"
                                        Command="{Binding SelectContextTabCommand}"
                                        CommandParameter="{x:Static models:ContextPanelTab.Preview}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.ContextUnderlineTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewContextTab}" Value="True">
                                                    <Setter Property="Tag" Value="Active" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- TAB 1: DOCUMENTS -->
                        <Grid Grid.Row="1"
                              Visibility="{Binding IsDocumentsContextTab, Converter={StaticResource BoolToVisibility}}"
                              AllowDrop="True"
                              Drop="OnContextDocumentsDrop">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,14,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DocumentsPanel.Documents.Count, StringFormat=문서 {0}개}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Secondary}"
                                        Height="30"
                                        Padding="10,0"
                                        FontSize="12"
                                        Content="+ 파일 추가"
                                        Command="{Binding DocumentsPanel.BrowseAndUploadCommand}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DocumentsPanel.Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="16,11">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding SourceFileName}"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Ellipse Width="6" Height="6"
                                                                     Fill="{Binding Status, Converter={StaticResource DocumentStatusToBrush}}"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Overflow ··· Menu -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource Button.IconGhost}"
                                                            Width="28" Height="28"
                                                            Click="OnOverflowButtonClick"
                                                            ToolTip="문서 작업">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="원문 보기"
                                                                          Command="{Binding DataContext.DocumentsPanel.OpenInPreviewCommand, Source={x:Reference RootShellProxy}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="색인 시작"
                                                                          Command="{Binding DataContext.DocumentsPanel.ProcessDocumentCommand, Source={x:Reference RootShellProxy}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="삭제"
                                                                          Command="{Binding DataContext.DocumentsPanel.DeleteDocumentCommand, Source={x:Reference RootShellProxy}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Data="{StaticResource Icon.More}"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="2"
                                                                  StrokeStartLineCap="Round"
                                                                  Width="24" Height="24" />
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- TAB 2: EVIDENCE (Flat hairline-separated entries, NO nested card boxes!) -->
                        <ScrollViewer Grid.Row="1"
                                      Visibility="{Binding IsEvidenceContextTab, Converter={StaticResource BoolToVisibility}}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,14,16,20">
                                <!-- Empty State -->
                                <TextBlock Visibility="{Binding EvidencePanel.HasTrace, Converter={StaticResource InverseBoolToVisibility}}"
                                           Text="답변의 인용 번호([1], [2]) 또는 근거 보기를 클릭하면 검색된 원문 청크와 점수가 여기에 표시됩니다."
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />

                                <!-- Active Trace Header + Metadata + Prompt Dialog Link -->
                                <StackPanel Visibility="{Binding EvidencePanel.HasTrace, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,0,12">
                                    <TextBlock Text="답변 근거"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Margin="0,2,0,14" />

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="생성 모델"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                            <TextBlock Text="{Binding EvidencePanel.ModelName}"
                                                       FontSize="13.5"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="응답 시간"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                            <TextBlock Text="{Binding EvidencePanel.LatencyLabel}"
                                                       FontSize="13.5"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding EvidencePanel.ChunkCountLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Style="{StaticResource Button.Link}"
                                                Content="프롬프트 보기"
                                                FontSize="12"
                                                Command="{Binding EvidencePanel.ShowPromptDialogCommand}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Flat Hairline-Separated Chunks -->
                                <ItemsControl Visibility="{Binding EvidencePanel.HasTrace, Converter={StaticResource BoolToVisibility}}"
                                              ItemsSource="{Binding EvidencePanel.Chunks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Setter Property="CornerRadius" Value="0" />
                                                        <Setter Property="Padding" Value="4,14,4,14" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="CornerRadius" Value="6" />
                                                                <Setter Property="Padding" Value="12,12,12,12" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding SourceFileName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Grid Margin="0,3,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding MetaLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ScoreLabel}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   Margin="8,0,0,0" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="13"
                                                               LineHeight="21"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,10" />

                                                    <Button Style="{StaticResource Button.Link}"
                                                            HorizontalAlignment="Right"
                                                            Padding="2,2"
                                                            Content="원문에서 확인 ↗"
                                                            FontSize="12"
                                                            FontWeight="Medium"
                                                            Command="{Binding DataContext.EvidencePanel.OpenInPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB 3: PREVIEW -->
                        <Grid Grid.Row="1"
                              Visibility="{Binding IsPreviewContextTab, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Preview Header Controls -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource Button.Link}"
                                                HorizontalAlignment="Left"
                                                Padding="0,2"
                                                Content="← 근거로 돌아가기"
                                                Command="{Binding BackToEvidenceCommand}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11.5"
                                                    Content="파일 연결"
                                                    Command="{Binding PreviewPanel.LinkLocalFileCommand}" />
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Height="26"
                                                    Padding="8,0"
                                                    FontSize="11.5"
                                                    Content="외부 앱"
                                                    IsEnabled="{Binding PreviewPanel.HasLocalFile}"
                                                    Command="{Binding PreviewPanel.OpenExternalCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0"
                                          Visibility="{Binding PreviewPanel.HasDocument, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PreviewPanel.FileName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Height="24" Padding="6,0" FontSize="11"
                                                    Content="◀"
                                                    Command="{Binding PreviewPanel.PreviousPageCommand}" />
                                            <TextBlock Text="{Binding PreviewPanel.PageBadgeLabel}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0" />
                                            <Button Style="{StaticResource Button.Ghost}"
                                                    Height="24" Padding="6,0" FontSize="11"
                                                    Content="▶"
                                                    Command="{Binding PreviewPanel.NextPageCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Preview Body -->
                            <Grid Grid.Row="1" Background="{DynamicResource Brush.Canvas}">
                                <TextBlock Visibility="{Binding PreviewPanel.HasDocument, Converter={StaticResource InverseBoolToVisibility}}"
                                           Text="Evidence 또는 Documents에서 문서를 선택하면 이 영역에서 원문을 미리볼 수 있습니다."
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="16,20" />

                                <wv2:WebView2 x:Name="PdfWebView"
                                              Visibility="{Binding PreviewPanel.HasLocalPdf, Converter={StaticResource BoolToVisibility}}" />

                                <ScrollViewer Visibility="{Binding PreviewPanel.HasTextPreview, Converter={StaticResource BoolToVisibility}}"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="16">
                                    <TextBlock Text="{Binding PreviewPanel.TextPreviewContent}"
                                               FontSize="13"
                                               LineHeight="21"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                </ScrollViewer>

                                <ScrollViewer Visibility="{Binding PreviewPanel.HasFallbackOnly, Converter={StaticResource BoolToVisibility}}"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="16">
                                    <StackPanel>
                                        <Border Background="{DynamicResource Brush.Side}"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <TextBlock Text="{Binding PreviewPanel.TextPreviewContent}"
                                                       FontSize="13"
                                                       LineHeight="21"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                        </Border>
                                        <Button Style="{StaticResource Button.Secondary}"
                                                Height="32"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Content="로컬 원본 파일 연결"
                                                Command="{Binding PreviewPanel.LinkLocalFileCommand}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Preview Status Footer -->
                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,1,0,0"
                                    Padding="14,8">
                                <TextBlock Text="{Binding PreviewPanel.StatusNote}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. BOTTOM STATUS BAR (24 DIP, Brush.Rail) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Rail}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding OverallServiceState, Converter={StaticResource ServiceStateToBrush}}"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusBarSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveModelLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text=" · "
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding ShortVersionLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FLOATING TOAST NOTIFICATION OVERLAY (Bottom-right, Light/Dark aware, deduplicated) -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding ActiveToasts}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,18,14"
                          Width="380"
                          Panel.ZIndex="100">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Canvas}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.14" Color="#000000" />
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static err:ErrorSeverity.Error}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static err:ErrorSeverity.Critical}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static err:ErrorSeverity.Warning}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         VerticalAlignment="Top"
                                         Margin="0,5,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static err:ErrorSeverity.Warning}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static err:ErrorSeverity.Error}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static err:ErrorSeverity.Critical}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ErrorCode, StringFormat= [{0}]}"
                                                   Visibility="{Binding ErrorCode, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12"
                                               LineHeight="18"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />

                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Button.Link}"
                                                        Content="{Binding Label}"
                                                        FontSize="11.5"
                                                        FontWeight="SemiBold"
                                                        Padding="4,2"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ExecuteToastActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource Button.IconGhost}"
                                        Width="22" Height="22"
                                        VerticalAlignment="Top"
                                        Margin="6,0,0,0"
                                        ToolTip="닫기"
                                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Viewbox Width="9" Height="9">
                                        <Path Data="{StaticResource Icon.Close}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              Width="24" Height="24" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>

<Window x:Class="Dograc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Dograc.App.ViewModels"
        xmlns:pages="clr-namespace:Dograc.App.Views.Pages"
        xmlns:models="clr-namespace:Dograc.Core.Models;assembly=Dograc.Core"
        Title="dograc — Local AI Research Workspace"
        Width="1360"
        Height="860"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <pages:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <pages:DocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspacesViewModel}">
            <pages:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
            <pages:ModelsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <pages:SystemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="{StaticResource Border.Hairline}"
            Background="{DynamicResource Brush.Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- 1. Custom Windows Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Border Width="22" Height="22"
                                CornerRadius="{StaticResource Radius.Small}"
                                Background="{DynamicResource Brush.Primary}"
                                Margin="0,0,8,0">
                            <TextBlock Text="d"
                                       Foreground="{DynamicResource Brush.TextOnPrimary}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="dograc"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Brush.PrimarySubtle}"
                                BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                                BorderThickness="{StaticResource Border.Hairline}"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="WORKSPACE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Primary}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl ItemsSource="{Binding ServiceStatuses}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenSystemPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="4,0,0,0"
                                            Cursor="Hand"
                                            ToolTip="{Binding DetailMessage}">
                                        <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="{StaticResource Border.Hairline}"
                                                CornerRadius="{StaticResource Radius.Small}"
                                                Padding="7,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                         Fill="{Binding State, Converter={StaticResource ServiceStateToBrush}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10.5"
                                                           Margin="4,0,0,0"
                                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="사이드바 접기/펼치기"
                                Margin="2,0">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8A0;" FontSize="13" />
                        </Button>

                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding ToggleContextPanelCommand}"
                                ToolTip="컨텍스트 패널 접기/펼치기"
                                Margin="2,0">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8A1;" FontSize="13" />
                        </Button>

                        <Button Style="{StaticResource Button.IconGhost}"
                                Command="{Binding CycleThemeCommand}"
                                ToolTip="테마 전환 (System / Light / Dark)"
                                Margin="2,0,8,0">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE793;" FontSize="13" />
                        </Button>

                        <Button Width="42" Height="40" Style="{StaticResource Button.IconGhost}" Click="OnMinimizeClick" ToolTip="최소화">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE921;" FontSize="10" />
                        </Button>
                        <Button Width="42" Height="40" Style="{StaticResource Button.IconGhost}" Click="OnMaximizeRestoreClick" ToolTip="최대화/복원">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE922;" FontSize="10" />
                        </Button>
                        <Button Width="42" Height="40" Style="{StaticResource Button.IconGhost}" Click="OnCloseClick" ToolTip="닫기">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8BB;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Shell Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ContextPanelWidth, Mode=TwoWay}" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <!-- 2.1 Left Navigation Rail -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="6,3"
                                        Height="42"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Page}"
                                        ToolTip="{Binding Tooltip}"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ItemBd"
                                                    CornerRadius="{StaticResource Radius.Medium}"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource Font.Icon}"
                                                               Text="{Binding Glyph}"
                                                               FontSize="15"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="9.5"
                                                               Margin="0,2,0,0"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 2.2 Workspace & Conversations Sidebar -->
                <Border Grid.Column="1"
                        Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,2,2,6">
                            <TextBlock Text="워크스페이스"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="관리"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding OpenWorkspacesPageCommand}"
                                    Padding="6,2"
                                    FontSize="11"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding Workspaces}"
                                  SelectedItem="{Binding SelectedWorkspace}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsApiReady}"
                                  Height="32"
                                  Margin="0,0,0,10" />

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource Input.Hairline}"
                                     Text="{Binding ConversationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsApiReady}"
                                     ToolTip="대화 제목 검색"
                                     Margin="0,0,6,0" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding CreateConversationCommand}"
                                    Content="+ 새 대화"
                                    IsEnabled="{Binding IsApiReady}"
                                    Padding="10,6" />
                        </Grid>

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding FilteredConversations}"
                                 SelectedItem="{Binding SelectedConversation}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="{StaticResource Border.Hairline}"
                                            CornerRadius="{StaticResource Radius.Small}"
                                            Padding="8,7"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12.5"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                                           Style="{StaticResource Text.Caption}"
                                                           FontSize="10.5" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource Button.IconGhost}"
                                                    Width="24" Height="24"
                                                    Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="대화 삭제">
                                                <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE74D;" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="2"
                              Width="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- 2.3 Central AI Workspace + Startup Banner -->
                <Grid Grid.Column="3" Background="{DynamicResource Brush.Canvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Visibility="{Binding ShowEnvironmentBanner, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource Brush.PrimarySubtle}"
                            BorderBrush="{DynamicResource Brush.PrimaryBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding BannerMessage}"
                                       Style="{StaticResource Text.BodyM}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="재시도"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding RetryStartupCommand}"
                                        Visibility="{Binding CanRetryStartup, Converter={StaticResource BoolToVisibility}}"
                                        Padding="10,4"
                                        Margin="0,0,6,0" />
                                <Button Content="System 보기"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding OpenSystemPageCommand}"
                                        Padding="10,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Setup Wizard"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding OpenSetupWizardCommand}"
                                        Padding="10,4" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" />
                </Grid>

                <GridSplitter Grid.Column="4"
                              Width="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- 2.4 Right Collapsible Context Panel (Documents / Evidence / Preview) -->
                <Border Grid.Column="5"
                        Visibility="{Binding IsContextPanelVisible, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Documents"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding SelectContextTabCommand}"
                                        CommandParameter="{x:Static models:ContextPanelTab.Documents}"
                                        Padding="10,4"
                                        Margin="0,0,4,0" />
                                <Button Content="Evidence"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding SelectContextTabCommand}"
                                        CommandParameter="{x:Static models:ContextPanelTab.Evidence}"
                                        Padding="10,4"
                                        Margin="0,0,4,0" />
                                <Button Content="Preview"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding SelectContextTabCommand}"
                                        CommandParameter="{x:Static models:ContextPanelTab.Preview}"
                                        Padding="10,4" />
                            </StackPanel>
                        </Border>

                        <!-- Context Tab 1: Documents (Connected to DocumentsViewModel) -->
                        <Grid Grid.Row="1"
                              DataContext="{Binding DocumentsPanel}"
                              Visibility="{Binding DataContext.IsDocumentsContextTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                              Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ActiveWorkspaceName}"
                                           Style="{StaticResource Text.TitleS}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Content="새로고침"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Padding="8,3"
                                        FontSize="11"
                                        HorizontalAlignment="Right" />
                            </Grid>

                            <Border Grid.Row="1"
                                    AllowDrop="True"
                                    Drop="OnContextDocumentsDrop"
                                    Background="{DynamicResource Brush.SurfaceSubtle}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="{StaticResource Border.Hairline}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PDF / TXT 끌어다 놓기"
                                               Style="{StaticResource Text.TitleS}"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <Button Content="파일 선택 업로드"
                                            Style="{StaticResource Button.Primary}"
                                            Command="{Binding BrowseAndUploadCommand}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Padding="10,4"
                                            FontSize="11.5"
                                            Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                                    Background="{DynamicResource Brush.DangerSubtle}"
                                    BorderBrush="{DynamicResource Brush.Danger}"
                                    BorderThickness="{StaticResource Border.Hairline}"
                                    CornerRadius="{StaticResource Radius.Small}"
                                    Padding="8,6"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="{StaticResource Border.Hairline}"
                                                    CornerRadius="{StaticResource Radius.Small}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                               Text="{Binding SourceFileName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SourceFileName}" />

                                                    <Button Grid.Row="0" Grid.Column="1"
                                                            Style="{StaticResource Button.IconGhost}"
                                                            Width="22" Height="22"
                                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="문서 삭제">
                                                        <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE74D;" FontSize="11" />
                                                    </Button>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                                                 Fill="{Binding Status, Converter={StaticResource DocumentStatusToBrush}}" />
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Content="색인 시작"
                                                                Style="{StaticResource Button.Secondary}"
                                                                Visibility="{Binding CanTriggerProcess, Converter={StaticResource BoolToVisibility}}"
                                                                Command="{Binding DataContext.ProcessDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2"
                                                                FontSize="10.5"
                                                                Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Context Tab 2: Evidence (Phase 5) -->
                        <Border Grid.Row="1"
                                Visibility="{Binding IsEvidenceContextTab, Converter={StaticResource BoolToVisibility}}"
                                Padding="16">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Evidence Panel" Style="{StaticResource Text.TitleS}" HorizontalAlignment="Center" />
                                <TextBlock Text="Phase 5에서 답변의 검색 청크, 유사도, 사용 모델 및 응답 시간이 표시됩니다."
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Context Tab 3: Preview (Phase 6) -->
                        <Border Grid.Row="1"
                                Visibility="{Binding IsPreviewContextTab, Converter={StaticResource BoolToVisibility}}"
                                Padding="16">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="PDF Preview Panel" Style="{StaticResource Text.TitleS}" HorizontalAlignment="Center" />
                                <TextBlock Text="Phase 6에서 PDF 원문 및 인용 페이지 확인 뷰가 연결됩니다."
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Bottom System Status Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="dograc Desktop · Phase 4"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

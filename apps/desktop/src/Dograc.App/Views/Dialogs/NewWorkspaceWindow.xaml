<Window x:Class="Dograc.App.Views.Dialogs.NewWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 워크스페이스"
        Icon="pack://application:,,,/dograc;component/Assets/dograc.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{DynamicResource Brush.Canvas}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.14" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="새 워크스페이스 만들기" FontSize="17" FontWeight="SemiBold" />
                <Button Grid.Column="1" Style="{StaticResource Button.IconGhost}" Click="OnCancelClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource Icon.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="24" Height="24" />
                    </Viewbox>
                </Button>
            </Grid>

            <TextBlock Text="문서와 대화를 분리해서 보관할 워크스페이스 이름을 입력하세요."
                       FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Margin="0,6,0,16" />

            <TextBox x:Name="NameInput"
                     Style="{StaticResource Input.Hairline}"
                     Tag="예: 사내 보안 규정, 연구 논문 모음"
                     Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource Button.Secondary}" Content="취소" Click="OnCancelClick" />
                <Button Style="{StaticResource Button.Primary}" Content="생성" Margin="8,0,0,0" Click="OnCreateClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

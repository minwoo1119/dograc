<Window x:Class="Dograc.App.Views.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dograc 로컬 환경 진단 및 설정"
        Icon="pack://application:,,,/dograc;component/Assets/dograc.ico"
        Width="680"
        MaxHeight="740"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">
    <Border Background="{DynamicResource Brush.Canvas}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="로컬 환경 진단 및 복구"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding SummaryMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{DynamicResource Brush.Side}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding AppLaunchStatusLabel}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                        </Border>
                        <Border BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRagFullyReady}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RagServiceStatusLabel}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource Button.IconGhost}"
                        VerticalAlignment="Top"
                        Click="OnCloseClick"
                        ToolTip="닫기">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource Icon.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="24" Height="24" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Detailed Diagnostic Checklist (Required vs Optional clearly separated) -->
            <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="필수 구성 요소 (앱 실행에 반드시 필요)"
                               Style="{StaticResource Text.SidebarLabel}"
                               Margin="4,0,0,8" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{Binding RequiredItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding State, Converter={StaticResource ServiceStateToBrush}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,6,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <Border Background="{DynamicResource Brush.Side}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Medium" Foreground="{Binding State, Converter={StaticResource ServiceStateToBrush}}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="감지 버전: " />
                                                    <Run Text="{Binding DetectedVersion, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <Run Text="  ·  요구: " />
                                                    <Run Text="{Binding RequiredVersion, Mode=OneWay}" />
                                                    <Run Text="  ·  경로: " />
                                                    <Run Text="{Binding ExecutableOrPath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding FailureReason}" Visibility="{Binding FailureReason, Converter={StaticResource StringNotEmptyToVisibility}}" FontSize="12" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Resolution}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Button.Link}" Content="설치 가이드 ↗" VerticalAlignment="Top"
                                                    Visibility="{Binding OfficialGuideUrl, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                    Command="{Binding DataContext.OpenGuideUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding OfficialGuideUrl}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="선택적 구성 요소 (로컬 인프라 · AI 모델 권장)"
                               Style="{StaticResource Text.SidebarLabel}"
                               Margin="4,0,0,8" />
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding OptionalItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding State, Converter={StaticResource ServiceStateToBrush}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,6,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <Border Background="{DynamicResource Brush.Side}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Medium" Foreground="{Binding State, Converter={StaticResource ServiceStateToBrush}}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="감지 버전: " />
                                                    <Run Text="{Binding DetectedVersion, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <Run Text="  ·  요구: " />
                                                    <Run Text="{Binding RequiredVersion, Mode=OneWay}" />
                                                    <Run Text="  ·  경로: " />
                                                    <Run Text="{Binding ExecutableOrPath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding FailureReason}" Visibility="{Binding FailureReason, Converter={StaticResource StringNotEmptyToVisibility}}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Resolution}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Button.Link}" Content="설치 가이드 ↗" VerticalAlignment="Top"
                                                    Visibility="{Binding OfficialGuideUrl, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                    Command="{Binding DataContext.OpenGuideUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding OfficialGuideUrl}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ActionNotice}"
                               Visibility="{Binding ActionNotice, Converter={StaticResource StringNotEmptyToVisibility}}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Accent}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProjectRoot}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}"
                            Content="나중에"
                            Click="OnCloseClick" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="다시 검사"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding IsNotRetrying}"
                            Command="{Binding RecheckOnlyCommand}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="{Binding StartButtonLabel}"
                            ToolTip="{Binding StartButtonTooltip}"
                            ToolTipService.ShowOnDisabled="True"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding CanStartServices}"
                            Command="{Binding RecheckAndStartCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

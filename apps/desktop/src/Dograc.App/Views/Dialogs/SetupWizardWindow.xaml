<Window x:Class="Dograc.App.Views.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dograc 초기 환경 구성 마법사"
        Width="560"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="초기 로컬 환경 구성 (Setup Wizard)" Style="{StaticResource Text.TitleM}" />
            <TextBlock Text="{Binding SummaryMessage}" Style="{StaticResource Text.BodyM}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{StaticResource Border.Hairline}"
                CornerRadius="{StaticResource Radius.Small}"
                Padding="10,6"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding ProjectRoot, StringFormat='감지된 프로젝트 경로: {0}'}"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CheckItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="{StaticResource Border.Hairline}"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="12,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontFamily="{StaticResource Font.Icon}"
                                           Text="&#xE73E;"
                                           FontSize="13"
                                           Margin="0,2,10,0"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Visibility="{Binding IsSatisfied, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="0"
                                           FontFamily="{StaticResource Font.Icon}"
                                           Text="&#xE7BA;"
                                           FontSize="13"
                                           Margin="0,2,10,0"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Visibility="{Binding IsSatisfied, Converter={StaticResource InverseBoolToVisibility}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.TitleS}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="닫기"
                    Style="{StaticResource Button.Secondary}"
                    Click="OnCloseClick"
                    Margin="0,0,8,0" />
            <Button Content="다시 검사 및 시작"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding RecheckAndStartCommand}" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="Dograc.App.Views.Dialogs.ErrorDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오류 상세 진단"
        Icon="pack://application:,,,/dograc;component/Assets/dograc.ico"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{DynamicResource Brush.Canvas}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.DangerSubtle}"
                                BorderBrush="{DynamicResource Brush.Error}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="ErrorCodeText"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Error}" />
                        </Border>
                        <TextBlock x:Name="TimestampText"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TitleText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="DescriptionText"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.IconGhost}" VerticalAlignment="Top" Click="OnCloseClick">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource Icon.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="24" Height="24" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Structured Fields -->
            <Border BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,1"
                    Margin="0,16,0,0"
                    Padding="0,14">
                <StackPanel>
                    <TextBlock x:Name="CauseLabelText" Style="{StaticResource Text.SidebarLabel}" />
                    <TextBlock x:Name="CauseText" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,12" />

                    <TextBlock Text="영향 범위" Style="{StaticResource Text.SidebarLabel}" />
                    <TextBlock x:Name="ImpactText" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,12" />

                    <TextBlock Text="해결 방법" Style="{StaticResource Text.SidebarLabel}" />
                    <TextBlock x:Name="ResolutionText" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Technical Details -->
            <TextBlock Text="기술 진단 정보 (개발자 참고용 · 민감 정보 자동 마스킹)"
                       Style="{StaticResource Text.SidebarLabel}"
                       Margin="0,14,0,6" />
            <Border Background="{DynamicResource Brush.Side}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    MaxHeight="170">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TechnicalBox"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             FontFamily="{StaticResource Font.Mono}"
                             FontSize="11.5"
                             TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Footer Actions -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}" Content="진단 정보 복사" Click="OnCopyClick" />
                    <Button Style="{StaticResource Button.Secondary}" Content="보고서 내보내기" Margin="8,0,0,0" Click="OnExportClick" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SafeExitButton"
                            Style="{StaticResource Button.Secondary}"
                            Content="안전 종료"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Click="OnSafeExitClick" />
                    <Button Style="{StaticResource Button.Primary}" Content="확인" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="Dograc.App.Views.Dialogs.QuickCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="빠른 명령 팔레트"
        Icon="pack://application:,,,/dograc;component/Assets/dograc.ico"
        Width="540"
        MaxHeight="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Border Background="{DynamicResource Brush.Canvas}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Search}"
                              Stroke="{DynamicResource Brush.TextMuted}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="24" Height="24" />
                    </Viewbox>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             CaretBrush="{DynamicResource Brush.Accent}"
                             FontSize="14"
                             VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged" />

                    <Border Grid.Column="2"
                            Background="{DynamicResource Brush.Side}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Filtered Results -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     MaxHeight="340"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6"
                     MouseDoubleClick="OnResultDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource Brush.SurfaceTone}"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>

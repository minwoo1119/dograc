APP_ENV=development
APP_NAME=dograc
API_HOST=0.0.0.0
API_PORT=8000
DOCS_ENABLED=true
BIND_ADDRESS=127.0.0.1
MAX_DOCUMENT_SIZE_BYTES=26214400

POSTGRES_DB=dograc
POSTGRES_USER=dograc
